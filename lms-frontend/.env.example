# Backend API Base URL
# For local development, use localhost
# For production, use your deployed backend URL
VITE_API_BASE_URL=http://localhost:8080

# AI Configuration (Optional but recommended for full AI features)
# Hugging Face Inference API Key (used for primary reasoning)
# Gemini API Key (used as fallback)
VITE_HF_API_KEY={HF_Acess token}
VITE_GEMINI_API_KEY={Gemini API key}
